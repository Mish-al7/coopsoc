{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "coopsoc-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "coopsoc-dev-localdb",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set MONGODB_URI=mongodb://127.0.0.1:27017&& npm run dev"],
      "port": 3000
    }
  ]
}
